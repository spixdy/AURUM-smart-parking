# Copy to .env and edit. Never commit .env.

# ---- MQTT broker -------------------------------------------------------------
# Local dev (docker compose) broker:
MQTT_HOST=mosquitto
MQTT_PORT=1883
# HiveMQ Cloud example:   MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud  MQTT_PORT=8883
# EMQX Cloud example:     MQTT_HOST=xxxxxxxx.emqxsl.com           MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=aurum/parking
# TLS is switched on automatically for port 8883/8084. Override with MQTT_TLS=true|false.

# ---- PostgreSQL (docker compose) -----------------------------------------------
POSTGRES_USER=aurum
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=aurum
# App connection string. Leave unset to use SQLite at data/aurum.db.
DATABASE_URL=postgresql://aurum:change-me-postgres@postgres:5432/aurum

# ---- InfluxDB 2.x ----------------------------------------------------------------
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=change-me-long-random-token
INFLUX_ORG=aurum
INFLUX_BUCKET=parking
INFLUX_ADMIN_PASSWORD=change-me-influx

# ---- Grafana ----------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=change-me-grafana
