{
 "uid": "aurum-live",
 "title": "AURUM \u00b7 Live parking",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-3d",
  "to": "now"
 },
 "timezone": "Asia/Kolkata",
 "tags": [
  "aurum"
 ],
 "templating": {
  "list": [
   {
    "name": "place",
    "label": "Place",
    "type": "query",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "pg"
    },
    "query": "SELECT DISTINCT place_id FROM readings ORDER BY 1",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Occupancy ratio by place",
   "datasource": {
    "type": "influxdb",
    "uid": "influx"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 16,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influx"
     },
     "query": "from(bucket: \"parking\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"occupancy\" and r._field == \"ratio\")\n  |> filter(fn: (r) => contains(value: r.place, set: ${place:json}))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
    }
   ]
  },
  {
   "id": 2,
   "type": "gauge",
   "title": "Average utilisation (selected places)",
   "datasource": {
    "type": "influxdb",
    "uid": "influx"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#c9a96a",
        "value": null
       },
       {
        "color": "#e8a23a",
        "value": 0.75
       },
       {
        "color": "#d9534f",
        "value": 0.9
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influx"
     },
     "query": "from(bucket: \"parking\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"occupancy\" and r._field == \"ratio\")\n  |> filter(fn: (r) => contains(value: r.place, set: ${place:json}))\n  |> group()\n  |> last()"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Vehicles parked (SQL)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pg"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 16,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pg"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT ts AS time, place_id AS metric, occupied AS value FROM readings WHERE $__timeFilter(ts) AND place_id IN ($place) ORDER BY ts"
    }
   ]
  },
  {
   "id": 4,
   "type": "table",
   "title": "Latest reading per place",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pg"
   },
   "gridPos": {
    "x": 16,
    "y": 9,
    "w": 8,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT DISTINCT ON (place_id) place_id AS place, occupied, capacity, ROUND(100.0*occupied/capacity) AS pct, ts FROM readings ORDER BY place_id, ts DESC"
    }
   ]
  }
 ]
}